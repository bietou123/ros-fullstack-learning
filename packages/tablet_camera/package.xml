<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tablet_camera</name>
  <version>0.1.0</version>
  <description>
    Publish a tablet/libcamera camera as ROS 2 sensor_msgs/Image + CameraInfo
    using GStreamer's libcamerasrc (ports work on Qualcomm CAMSS devices that
    have no v4l2_camera/usb_cam compatible driver).
  </description>
  <maintainer email="bietou123@users.noreply.github.com">bietou123</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-gi</exec_depend>
  <exec_depend>gir1.2-gst-plugins-base-1.0</exec_depend>
  <exec_depend>gstreamer1.0-libcamera</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
